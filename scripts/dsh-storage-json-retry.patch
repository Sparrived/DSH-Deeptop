+import { lstat, open, rename, rm } from 'node:fs/promises'
+import { setTimeout as delay } from 'node:timers/promises'
 import { dirname, join } from 'node:path'
 import { randomUUID } from 'node:crypto'
 
+// Bounded at ten retries; permanent ACLs or sustained handles still fail loud.
+const WIN32_RENAME_RETRY_LIMIT = 10
+const WIN32_RENAME_RETRY_DELAY_MS = 50
+
+/** Whether a rename failure is a transient Windows target lock worth retrying. */
+async function isRetryableWin32RenameError(error: unknown, path: string): Promise<boolean> {
+  const code = (error as NodeJS.ErrnoException | null)?.code
+  if (process.platform !== 'win32' || (code !== 'EACCES' && code !== 'EBUSY' && code !== 'EPERM')) return false
+  try {
+    return !(await lstat(path)).isDirectory()
+  } catch {
+    return true
+  }
+}
+
+async function renameWithRetry(tmp: string, path: string): Promise<void> {
+  for (let retry = 0; ; retry++) {
+    try {
+      await rename(tmp, path)
+      return
+    } catch (error) {
+      if (retry >= WIN32_RENAME_RETRY_LIMIT || !await isRetryableWin32RenameError(error, path)) throw error
+      await delay((retry + 1) * WIN32_RENAME_RETRY_DELAY_MS)
+    }
+  }
+}
