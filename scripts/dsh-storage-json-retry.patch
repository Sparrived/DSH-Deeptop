@@ -0,0 +1,126 @@
+import { mkdir, mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+const state = vi.hoisted(() => ({
+  renameFailures: [] as string[],
+  renameCalls: 0,
+  retryDelays: [] as number[],
+}))
+
+vi.mock('node:fs/promises', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('node:fs/promises')>()
+  return {
+    ...actual,
+    rename: (async (...args: Parameters<typeof actual.rename>) => {
+      state.renameCalls += 1
+      const code = state.renameFailures.shift()
+      if (code !== undefined) throw Object.assign(new Error(`injected ${code}`), { code })
+      return actual.rename(...args)
+    }),
+  }
+})
+
+vi.mock('node:timers/promises', () => ({
+  setTimeout: async (delay: number): Promise<void> => { state.retryDelays.push(delay) },
+}))
+
+const roots: string[] = []
+const platformDescriptor = Object.getOwnPropertyDescriptor(process, 'platform')!
+
+async function scratch(): Promise<string> {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-storage-json-atomic-'))
+  roots.push(root)
+  return root
+}
+
+function usePlatform(platform: NodeJS.Platform): void {
+  Object.defineProperty(process, 'platform', { ...platformDescriptor, value: platform })
+}
+
+afterEach(async () => {
+  state.renameFailures.length = 0
+  state.renameCalls = 0
+  state.retryDelays.length = 0
+  Object.defineProperty(process, 'platform', platformDescriptor)
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true })
+})
+
+describe('writeAtomic Windows rename retries', () => {
+  it('retries transient replacement failures and publishes the complete file', async () => {
+    const root = await scratch()
+    const path = join(root, 'workspace.json')
+    await writeFile(path, 'before')
+    state.renameFailures.push('EPERM', 'EBUSY', 'EACCES')
+    usePlatform('win32')
+
+    const { writeAtomic } = await import('../src/atomic.ts')
+    await writeAtomic(path, 'after')
+
+    expect(await readFile(path, 'utf8')).toBe('after')
+    expect(state.renameCalls).toBe(4)
+    expect(state.retryDelays).toEqual([50, 100, 150])
+    expect((await readdir(root)).filter(name => name.endsWith('.tmp'))).toEqual([])
+  })
+
+  it('preserves non-transient failures without delaying', async () => {
+    const root = await scratch()
+    const path = join(root, 'workspace.json')
+    await writeFile(path, 'before')
+    state.renameFailures.push('EIO')
+    usePlatform('win32')
+
+    const { writeAtomic } = await import('../src/atomic.ts')
+    await expect(writeAtomic(path, 'after')).rejects.toMatchObject({ code: 'EIO' })
+
+    expect(await readFile(path, 'utf8')).toBe('before')
+    expect(state.renameCalls).toBe(1)
+    expect(state.retryDelays).toEqual([])
+    expect((await readdir(root)).filter(name => name.endsWith('.tmp'))).toEqual([])
+  })
+
+  it('does not retry a transient code off Windows', async () => {
+    const root = await scratch()
+    const path = join(root, 'workspace.json')
+    state.renameFailures.push('EPERM')
+    usePlatform('linux')
+
+    const { writeAtomic } = await import('../src/atomic.ts')
+    await expect(writeAtomic(path, 'after')).rejects.toMatchObject({ code: 'EPERM' })
+
+    expect(state.renameCalls).toBe(1)
+    expect(state.retryDelays).toEqual([])
+  })
+
+  it('does not retry an EPERM caused by a directory target', async () => {
+    const root = await scratch()
+    const path = join(root, 'workspace.json')
+    await mkdir(path)
+    state.renameFailures.push('EPERM')
+    usePlatform('win32')
+
+    const { writeAtomic } = await import('../src/atomic.ts')
+    await expect(writeAtomic(path, 'after')).rejects.toMatchObject({ code: 'EPERM' })
+
+    expect(state.renameCalls).toBe(1)
+    expect(state.retryDelays).toEqual([])
+    expect((await readdir(root)).filter(name => name.endsWith('.tmp'))).toEqual([])
+  })
+
+  it('stops after the bounded Windows retry budget', async () => {
+    const root = await scratch()
+    const path = join(root, 'workspace.json')
+    await writeFile(path, 'before')
+    state.renameFailures.push(...Array.from({ length: 11 }, () => 'EPERM'))
+    usePlatform('win32')
+
+    const { writeAtomic } = await import('../src/atomic.ts')
+    await expect(writeAtomic(path, 'after')).rejects.toMatchObject({ code: 'EPERM' })
+
+    expect(await readFile(path, 'utf8')).toBe('before')
+    expect(state.renameCalls).toBe(11)
+    expect(state.retryDelays).toEqual([50, 100, 150, 200, 250, 300, 350, 400, 450, 500])
+    expect((await readdir(root)).filter(name => name.endsWith('.tmp'))).toEqual([])
+  })
+})
