+describe('Session fork preset migration', () => {
+  it('rejects a migration when no preset roster can validate the replacement', async () => {
+    const ctx = await baseContext()
+    ctx.provide('workspaceRegistry', { list: () => [] } as never)
+    const source = completedSession(ctx, 'migration-no-roster', '/workspace')
+    const controller = new SessionCommandController(ctx, controllerAgents(), '/default')
+
+    await expect(controller.fork({
+      sessionId: source.id,
+      agentPreset: 'minimal',
+    })).rejects.toMatchObject({
+      code: 'agent-preset/not-found',
+      details: { agentPreset: 'minimal', available: [] },
+    })
+    expect(ctx.sessions.list().map(session => session.id)).toEqual([source.id])
+    await ctx.fiber.dispose()
+  })
+
+  it('rejects an unknown replacement before creating a child', async () => {
+    const ctx = await baseContext()
+    ctx.provide('workspaceRegistry', { list: () => [] } as never)
+    ctx.provide('agentPresets', {
+      resolve: () => Promise.reject(new RemoteError(
+        'agent-preset/not-found',
+        'agent-presets: preset "minimal" not found (available: standard)',
+        { agentPreset: 'minimal', available: ['standard'] },
+      )),
+    } as never)
+    const source = completedSession(ctx, 'migration-unknown', '/workspace')
+    const create = vi.spyOn(ctx.agents, 'create')
+    const controller = new SessionCommandController(ctx, controllerAgents({
+      composeAgent: (presetId?: string) => Promise.reject(new RemoteError(
+        'agent-preset/not-found',
+        `agent-presets: preset "${presetId}" not found (available: standard)`,
+        { agentPreset: presetId ?? '', available: ['standard'] },
+      )),
+    }), '/default')
+
+    await expect(controller.fork({
+      sessionId: source.id,
+      agentPreset: 'minimal',
+    })).rejects.toMatchObject({ code: 'agent-preset/not-found' })
+    expect(create).not.toHaveBeenCalled()
+    expect(ctx.sessions.list().map(session => session.id)).toEqual([source.id])
+    await ctx.fiber.dispose()
+  })
+
+  it('migrates the complete history under an explicitly selected preset', async () => {
+    const ctx = await baseContext()
+    ctx.provide('workspaceRegistry', { list: () => [] } as never)
+    ctx.provide('agentPresets', {
+      resolve: (id?: string) => Promise.resolve({ id: id ?? 'standard' }),
+    } as never)
+    const source = completedSession(ctx, 'migration-source', '/workspace')
+    const sourceEvents = source.snapshotEvents()
+    const sourceTypes = sourceEvents.map(event => event.type)
+    const create = vi.spyOn(ctx.agents, 'create').mockImplementation(
+      (options: CreateAgentOptions) => Promise.resolve(resolvedHandle(ctx, options.sessionId)),
+    )
+    const controller = new SessionCommandController(ctx, controllerAgents({
+      composeAgent: () => Promise.resolve({
+        agentPreset: 'minimal',
+        setup: async () => {},
+      }),
+    }), '/default')
+
+    const forked = await controller.fork({
+      sessionId: source.id,
+      agentPreset: 'minimal',
+    })
+    expect(forked.sessionId).toMatch(/^session-/)
+    const options = create.mock.calls[0]?.[0]
+    if (options === undefined) throw new Error('Agent creation was not attempted')
+    if (options.seed === undefined) throw new Error('Forked agent creation did not receive the source history')
+    expect(options.seed.map(event => event.type)).toEqual(sourceTypes)
+    expect(options.inheritedEventCount).toBe(SessionLogOffset(sourceEvents.length))
+    expect(options.meta).toMatchObject({
+      parentSession: source.id,
+      agentPreset: 'minimal',
+      isSeeded: true,
+    })
+    expect(source.snapshotEvents().map(event => event.type)).toEqual(sourceTypes)
+
+    // The migration setup records the explicit selection only after the
+    // composed setup settled.
+    const append = vi.fn()
+    await options.setup?.({} as never, { session: { append } } as never)
+    expect(append).toHaveBeenCalledWith('agent-preset/selected', { agentPreset: 'minimal' })
+    await ctx.fiber.dispose()
+  })
+})
