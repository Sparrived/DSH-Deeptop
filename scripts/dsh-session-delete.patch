+    const otherProject = meta('remove-other-project', '/work/b')
+    for (const m of [target, neighbor, otherProject]) {
+      const handle = await ctx.sessionPersistence.create(m)
+      await handle.append(oneTurnLog())
+      await handle.close()
+    }
