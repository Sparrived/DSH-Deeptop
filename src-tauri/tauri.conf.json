{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deeptop",
  "version": "0.1.4-dev.4",
  "identifier": "com.deeptop.desktop",
  "build": {
    "beforeDevCommand": "npm run dsh:sync && npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deeptop",
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "resources": {
      "resources/dsh-runtime.tar.gz": "dsh-runtime.tar.gz",
      "resources/dsh-runtime-manifest.json": "dsh-runtime-manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
